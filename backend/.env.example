# Copy to .env for local dev (never commit the real .env)
PORT=8080
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Persistence: leave unset (or false) for in-memory dev storage,
# or "true" to persist to Cloud Firestore (Native mode).
USE_FIRESTORE=false

# One-off migration of old MongoDB accounts: on first login with an unknown
# email, forward the credentials to this legacy API and import the account
# (with conversations, settings, memory) into Firestore. Set to '' to disable.
LEGACY_API_BASE=https://api.mmi25b11.mmi-troyes.fr
# Only needed locally for Firestore; on Cloud Run, ADC handles auth.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
