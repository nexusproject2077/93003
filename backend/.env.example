# Copy to .env for local dev (never commit the real .env)
PORT=8080
JWT_SECRET=replace-with-a-long-random-string
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio (free) — enables the Gemini models in the picker.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Persistence: leave unset (or false) for in-memory dev storage,
# or "true" to persist to Cloud Firestore (Native mode).
USE_FIRESTORE=false

# One-off migration of old MongoDB accounts: on first login with an unknown
# email, forward the credentials to this legacy API and import the account
# (with conversations, settings, memory) into Firestore. Set to '' to disable.
LEGACY_API_BASE=https://api.mmi25b11.mmi-troyes.fr

# Quotas — free users are hard-capped per day to protect against provider cost.
FREE_DAILY_LIMIT=20
PRO_DAILY_LIMIT=500
# Public site URL, used for Stripe Checkout redirects.
APP_URL=https://nexus-ai-608af.web.app

# Stripe subscription (Nexus Pro, 18€/month). Leave blank to disable billing
# (free quota still enforced; the subscribe button shows "unavailable").
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Only needed locally for Firestore; on Cloud Run, ADC handles auth.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
